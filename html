<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nave Espacial en la Galaxia</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow: hidden;
            background: #000;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .galaxy {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a0a2e 50%, #0a0a1a 100%);
            overflow: hidden;
        }

        /* Estrellas de fondo */
        .stars {
            position: absolute;
            width: 100%;
            height: 100%;
            background: transparent;
        }

        .stars::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(1px 1px at 20px 30px, white, transparent),
                radial-gradient(1px 1px at 40px 70px, white, transparent),
                radial-gradient(1px 1px at 50px 160px, white, transparent),
                radial-gradient(1px 1px at 90px 40px, white, transparent),
                radial-gradient(1px 1px at 130px 80px, white, transparent),
                radial-gradient(1px 1px at 160px 120px, white, transparent),
                radial-gradient(2px 2px at 200px 50px, white, transparent),
                radial-gradient(1px 1px at 250px 90px, white, transparent),
                radial-gradient(1px 1px at 300px 130px, white, transparent),
                radial-gradient(1px 1px at 350px 60px, white, transparent),
                radial-gradient(2px 2px at 400px 100px, white, transparent),
                radial-gradient(1px 1px at 450px 140px, white, transparent);
            background-size: 500px 200px;
            animation: moveStars 50s linear infinite;
        }

        @keyframes moveStars {
            from { transform: translateX(0); }
            to { transform: translateX(-500px); }
        }

        /* Nebulosa */
        .nebula {
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(138, 43, 226, 0.3) 0%, transparent 70%);
            border-radius: 50%;
            top: 20%;
            left: 30%;
            animation: float 20s ease-in-out infinite;
            filter: blur(40px);
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(50px, -30px) scale(1.1); }
        }

        /* Planetas */
        .planet {
            position: absolute;
            border-radius: 50%;
            box-shadow: inset -20px -20px 40px rgba(0,0,0,0.5);
        }

        .planet-1 {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #ff6b6b, #c92a2a);
            top: 60%;
            left: 80%;
            animation: orbit1 30s linear infinite;
        }

        .planet-2 {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #4dabf7, #1971c2);
            top: 30%;
            left: 10%;
            animation: orbit2 45s linear infinite;
        }

        .planet-3 {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #ffd43b, #f59f00);
            top: 70%;
            left: 20%;
            animation: orbit3 25s linear infinite;
        }

        @keyframes orbit1 {
            from { transform: rotate(0deg) translateX(100px) rotate(0deg); }
            to { transform: rotate(360deg) translateX(100px) rotate(-360deg); }
        }

        @keyframes orbit2 {
            from { transform: rotate(0deg) translateX(150px) rotate(0deg); }
            to { transform: rotate(360deg) translateX(150px) rotate(-360deg); }
        }

        @keyframes orbit3 {
            from { transform: rotate(0deg) translateX(80px) rotate(0deg); }
            to { transform: rotate(360deg) translateX(80px) rotate(-360deg); }
        }

        /* Nave espacial */
        .spaceship {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 120px;
            animation: fly 3s ease-in-out infinite;
            cursor: pointer;
            transition: transform 0.3s;
        }

        .spaceship:hover {
            transform: translate(-50%, -50%) scale(1.1);
        }

        .spaceship:hover .engine {
            background: linear-gradient(to bottom, #ff0000, #ff6600, #ffff00);
            box-shadow: 0 0 30px #ff6600, 0 0 60px #ff0000;
        }

        .ship-body {
            position: absolute;
            width: 40px;
            height: 80px;
            background: linear-gradient(135deg, #c0c0c0, #808080);
            border-radius: 50% 50% 20% 20%;
            left: 50%;
            transform: translateX(-50%);
            box-shadow: 0 0 20px rgba(192, 192, 192, 0.5);
        }

        .ship-wing-left {
            position: absolute;
            width: 30px;
            height: 50px;
            background: linear-gradient(135deg, #a0a0a0, #606060);
            left: 0;
            top: 40px;
            transform: skewY(-20deg);
            border-radius: 5px;
        }

        .ship-wing-right {
            position: absolute;
            width: 30px;
            height: 50px;
            background: linear-gradient(135deg, #a0a0a0, #606060);
            right: 0;
            top: 40px;
            transform: skewY(20deg);
            border-radius: 5px;
        }

        .ship-window {
            position: absolute;
            width: 20px;
            height: 20px;
            background: radial-gradient(circle, #00ffff, #0088ff);
            border-radius: 50%;
            left: 50%;
            top: 20px;
            transform: translateX(-50%);
            box-shadow: 0 0 15px #00ffff;
            animation: glow 2s ease-in-out infinite;
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 15px #00ffff; }
            50% { box-shadow: 0 0 25px #00ffff, 0 0 40px #0088ff; }
        }

        .engine {
            position: absolute;
            width: 20px;
            height: 40px;
            background: linear-gradient(to bottom, #ff6600, #ff0000, transparent);
            left: 50%;
            bottom: -40px;
            transform: translateX(-50%);
            border-radius: 50% 50% 0 0;
            animation: enginePulse 0.2s ease-in-out infinite;
            box-shadow: 0 0 20px #ff6600;
        }

        @keyframes enginePulse {
            0%, 100% { height: 40px; opacity: 1; }
            50% { height: 50px; opacity: 0.8; }
        }

        @keyframes fly {
            0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
            25% { transform: translate(-50%, -55%) rotate(-2deg); }
            75% { transform: translate(-50%, -45%) rotate(2deg); }
        }

        /* Asteroides */
        .asteroid {
            position: absolute;
            width: 30px;
            height: 30px;
            background: radial-gradient(circle, #8b7355, #5c4a3a);
            border-radius: 40% 60% 50% 70%;
            box-shadow: inset -5px -5px 10px rgba(0,0,0,0.5);
        }

        .asteroid-1 {
            top: 20%;
            left: 100%;
            animation: asteroidMove1 15s linear infinite;
        }

        .asteroid-2 {
            top: 60%;
            left: 100%;
            animation: asteroidMove2 20s linear infinite;
            animation-delay: -5s;
        }

        .asteroid-3 {
            top: 40%;
            left: 100%;
            animation: asteroidMove3 18s linear infinite;
            animation-delay: -10s;
        }

        @keyframes asteroidMove1 {
            from { transform: translateX(0) rotate(0deg); }
            to { transform: translateX(-120vw) rotate(360deg); }
        }

        @keyframes asteroidMove2 {
            from { transform: translateX(0) rotate(0deg); }
            to { transform: translateX(-120vw) rotate(-360deg); }
        }

        @keyframes asteroidMove3 {
            from { transform: translateX(0) rotate(0deg); }
            to { transform: translateX(-120vw) rotate(720deg); }
        }

        /* Título */
        .title {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: #00ffff;
            font-family: 'Courier New', monospace;
            font-size: 24px;
            text-shadow: 0 0 10px #00ffff, 0 0 20px #0088ff;
            letter-spacing: 3px;
            animation: titleGlow 3s ease-in-out infinite;
        }

        @keyframes titleGlow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
    </style>
</head>
<body>
    <div class="galaxy">
        <div class="title">EXPLORACIÓN GALÁCTICA</div>
        <div class="stars"></div>
        <div class="nebula"></div>
        
        <div class="planet planet-1"></div>
        <div class="planet planet-2"></div>
        <div class="planet planet-3"></div>
        
        <div class="asteroid asteroid-1"></div>
        <div class="asteroid asteroid-2"></div>
        <div class="asteroid asteroid-3"></div>
        
        <div class="spaceship">
            <div class="ship-wing-left"></div>
            <div class="ship-wing-right"></div>
            <div class="ship-body">
                <div class="ship-window"></div>
            </div>
            <div class="engine"></div>
        </div>
    </div>
</body>
</html>
